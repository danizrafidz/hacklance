<!DOCTYPE html>
<html lang="en">
    <%- include('_partials/_head', {title: project.title}) %>
<body>
    <%- include('_partials/_navbar', {heading: project.title}) %>
    <!-- project -->
     <!-- bids -->

    <% if (user.role === 'hacklancer') { %>  
        <button onclick="location.href='/projects/<%= project.id %>/bids/bid'">Bid Project</button>
    <% } %>  

    <table>
        <tr>
            <th>No</th>
            <th>Bidder</th>
            <th>Proposal</th>
            <th>Bid Amount</th>
            <th>Terms</th>
            <th>Status</th>
            <% if (user.id === project.ClientId && project.status === 'open') { %>  
                <th>Action</th>
            <% } %>     
            <th>Invoice</th> <!-- New column for invoice -->
        </tr>
    
        <% bids.forEach((bid, i) => { %>
            <tr>
                <td><%= i + 1 %></td>
                <td><%= bid.Hacklancer.username %></td>
                <td><%= bid.proposalText %></td>
                <td><%= formatToCurrency(bid.bidAmount) %></td>
                <td><%= bid.terms %> days</td>
                
                <% if (bid.status === 'pending') { %>
                    <td style="background-color: rgb(156, 156, 86);"><%= bid.status %></td>
                <% } else if (bid.status === 'accepted') { %>
                    <td style="background-color: green;"><%= bid.status %></td>
                <% } else if (bid.status === 'rejected') { %>
                    <td style="background-color: red;"><%= bid.status %></td>
                <% } %>
    
                <% if (user.id === project.ClientId && project.status === 'open') { %>  
                    <td>
                        <button onclick="location.href='/projects/<%= project.id %>/bids/<%= bid.id %>/accept'">Accept</button>
                    </td>
                <% } %>
    
                <!-- Button for generating the invoice -->
                <td>
                    <% if (bid.status === 'accepted') { %>
                        <a href="/projects/<%= project.id %>/bids?generateInvoice=<%= bid.id %>">
                            Download Invoice
                        </a>
                    <% } else { %>
                        Not available
                    <% } %>
                </td>
            </tr>
        <% }) %>
    </table>
    
</body>
</html>