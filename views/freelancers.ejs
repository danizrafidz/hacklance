<!DOCTYPE html>
<html lang="en">
    <%- include('_partials/_head', {title: 'List of Factions'}) %>
<body>
    <%- include('_partials/_navbar', {heading: 'List of Factions'}) %>
    <!-- freelancers -->

    <table>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Password</th>
            <th>Role</th>
            <th>Action</th>
        </tr>
        <% freelancers.forEach(freelancer => { %>
            <tr>
                <td><%= freelancer.id %></td>
                <td><%= freelancer.name %></td>
                <td><%= freelancer.email %></td>
                <td><%= freelancer.password %></td>
                <td><%= freelancer.role %></td>
                <td>
                    <button onclick="location.href='/freelancers/<%= freelancer.id %>/setClient'">Set Client</button>
                    <button onclick="location.href='/freelancers/<%= freelancer.id %>/pawns'">View Services</button>
                </td>
            </tr>
        <% }) %>
    </table>
</body>
</html>