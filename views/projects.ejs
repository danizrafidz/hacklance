<!DOCTYPE html>
<html lang="en">
    <%- include('_partials/_head', {title: 'List of Projects'}) %>
<body>
    <%- include('_partials/_navbar', {heading: 'List of Projects'}) %>

    <% if (user.role === 'client') { %>  
        <button onclick="location.href='/projects/create'">Post New Project</button>
    <% } %>  

    <form action="/projects" method="GET">
        <input type="radio" id="oldest" name="sort" value="ASC">
        <label for="oldest">From Oldest</label>
        <input type="radio" id="newest" name="sort" value="DESC">
        <label for="newest">From Newest</label>

        <input type="text" name="search" placeholder="Search by title...">
        <input type="submit" value="Filter or Search">
    </form>

    <table>
        <tr>
            <th>No</th>
            <th>Image</th>
            <th>Title</th>
            <th>Description</th>
            <th>Budget</th>
            <th>Skill Requirements</th>
            <th>Status</th>
            <th>Posted By</th>
            <th>Posted</th>
            <th>Bidders</th>
            <th>Action</th>
        </tr>

        <% projects.forEach((project, i) => { %>
            <tr>
                <td><%= i + 1 %></td>
                <td>
                    <img width="200px" src="<%= project.imageURL %>">
                </td>
                <td><%= project.title %></td>
                <td><%= project.description %></td>
                <td><%= formatToCurrency(project.budget) %></td>
                <td><%= project.Skill.name %></td>
                
                <% if (project.status === 'open') { %>
                    <td style="background-color: green;"><%= project.status %></td>
                <% } else if (project.status === 'in progress') { %>
                    <td style="background-color: rgb(156, 156, 86);"><%= project.status %></td>
                <% } else if (project.status === 'completed') { %>
                    <td style="background-color: rgb(0, 123, 255);"><%= project.status %></td>
                <% } %>

                <td><%= project.User.username %></td>
                <td><%= timeAgo.format(project.createdAt) %></td>
                <td><%= project.Bids.length %> bids</td>
                <td>
                    <button onclick="location.href='/projects/<%= project.id %>/bids'">See Bids</button>
                </td>
            </tr>
        <% }) %>
    </table>
</body>
</html>